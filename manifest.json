{
  "name": "Aardvark2",
  "description": "Edit and simplify web pages for printing: remove or isolate content, adjust styling, and undo or redo changes.",
  "version": "3.1.1",
  "icons": {
    "32": "icon.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Launch Aardvark Page Editor",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "aardvark.gif",
        "aardvarkhelp.gif",
        "closedbox.gif"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "manifest_version": 3
}
